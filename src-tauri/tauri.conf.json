{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POE Tracker",
  "version": "0.0.2",
  "identifier": "com.rodgons.poetracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "corner",
        "title": "POE Tracker",
        "url": "index.html",
        "width": 340,
        "height": 200,
        "visible": true,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "signingIdentity": "-" }
  }
}
