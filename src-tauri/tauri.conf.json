{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POE Tracker",
  "version": "0.4.0",
  "identifier": "com.rodgons.poetracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "corner",
        "title": "POE Tracker",
        "url": "index.html",
        "width": 436,
        "height": 520,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "setup",
        "title": "POE Tracker · Set up build",
        "url": "setup.html",
        "width": 520,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "build",
        "title": "POE Tracker · Build",
        "url": "build.html",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
